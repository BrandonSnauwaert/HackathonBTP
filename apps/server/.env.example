PORT=3000
# Base SQLite (créée automatiquement)
DATABASE_PATH=data/app.sqlite
SESSION_TTL_DAYS=30
# true derrière HTTPS (tunnel de démo)
COOKIE_SECURE=false
# Jours sans réponse après l'envoi avant « à relancer »
FOLLOW_UP_AFTER_DAYS=7
# Adresse du front vue par les clients, pour le lien des devis envoyés (derrière le tunnel : https://...)
PUBLIC_BASE_URL=http://localhost:5173

# mock | kyutai
TRANSCRIBER=mock
KYUTAI_URL=ws://localhost:8080/api/asr-streaming
KYUTAI_API_KEY=public_token
# Durée de pause qui clôt une phrase : 0=0,5s 1=1s 2=2s 3=3s
KYUTAI_PAUSE_HEAD=1
KYUTAI_PAUSE_THRESHOLD=0.5

# Dictées (clips audio)
CLIPS_DIR=data/clips
MAX_CLIP_SECONDS=300

# Photos de chantier
PHOTOS_DIR=data/photos
MAX_PHOTO_MB=10

# LLM : n'importe quelle API compatible OpenAI (/v1/chat/completions)
# mock = extraction simulée sans LLM | openai = client compatible OpenAI
LLM_PROVIDER=mock
# Vide = api.openai.com. Exemples : https://api.mistral.ai/v1, https://openrouter.ai/api/v1, http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
# Obligatoire si LLM_PROVIDER=openai
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
# Comment demander du JSON : json_object (le plus répandu), json_schema (OpenAI, vLLM...), none (prompt seul)
LLM_JSON_MODE=json_object
